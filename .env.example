# -------------------------------------------------------------
# FamilyConnect MVP — Environment Configuration Template
# Copy this file to .env and adjust variables for your environment.
# -------------------------------------------------------------

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgres://familyconnect:familyconnect@localhost:5432/familyconnect

# JWT Authentication Secret (MUST be changed in production!)
JWT_SECRET=fc-dev-secret-change-in-production

# AI Provider Configuration: 'ollama' (local) or 'gemini' (cloud)
AI_PROVIDER=ollama

# Local Ollama Settings (e.g. gemma4:e4b, mistral, llama3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Google Gemini API Settings (Required if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
